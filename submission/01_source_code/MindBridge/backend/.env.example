# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# LLM provider: auto | local | gemini
#   auto -> use local Ollama if reachable, otherwise fall back to Gemini
# ------------------------------------------------------------------
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.2

# Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen2.5:7b
# DEFAULT_LOCAL_MODEL=llama3.2
OLLAMA_AUTO_INSTALL=true
OLLAMA_AUTO_PULL=true
OLLAMA_STARTUP_TIMEOUT=15
OLLAMA_INSTALL_TIMEOUT=600
OLLAMA_PULL_TIMEOUT=3600
OLLAMA_LOAD_TIMEOUT=180
# In auto mode: seconds to wait for local readiness before falling back to Gemini
OLLAMA_AUTO_FALLBACK_TIMEOUT=30

# Cloud (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
# Fail fast on an overloaded model instead of retrying for minutes
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=2

# ------------------------------------------------------------------
# Persistence (SQLite)
# ------------------------------------------------------------------
DATABASE_PATH=./data/mental_health_agent.db
CHECKPOINT_DB_PATH=./data/langgraph_checkpoints.db

# ------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------
# JSONL trace of every LangGraph run (nodes, tool calls, routing, reflection)
EXECUTION_LOG_ENABLED=true
EXECUTION_LOG_PATH=./logs/execution_trace.jsonl
# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=mental-health-screening-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
